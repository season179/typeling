{
  "name": "typeling",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run db:migrate:local && PORTLESS_TLD=dev bun run dev:proxy && concurrently --kill-others-on-fail --names aligner,web 'bun run dev:aligner' 'TYPELING_CLOUDFLARE=1 PORTLESS_TLD=dev portless typeling vite --host 127.0.0.1'",
    "dev:aligner": "bun run scripts/aligner-server.ts",
    "dev:proxy": "portless proxy start --https",
    "dev:direct": "concurrently --kill-others --names api,web 'PORT=${SERVER_PORT:-3001} bun --watch src/server/index.ts' 'SERVER_URL=http://127.0.0.1:${SERVER_PORT:-3001} vite --host 127.0.0.1 --port 5173 --strictPort'",
    "dev:cloud": "TYPELING_CLOUDFLARE=1 vite --host 127.0.0.1",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply typeling-content --local",
    "db:migrate:remote": "wrangler d1 migrations apply typeling-content --remote",
    "db:seed:local": "bun run scripts/seed-story-d1.ts --local",
    "assets:seed:local": "bun run scripts/seed-assets-r2.ts --local",
    "audio:publish": "bun run scripts/publish-episode-audio.ts",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "gen:season": "bun run scripts/gen-season.ts",
    "e2e:happy-path": "bun run scripts/e2e/happy-path.ts",
    "e2e:wrong-key": "bun run scripts/e2e/wrong-key.ts",
    "e2e:idle": "bun run scripts/e2e/idle.ts"
  },
  "dependencies": {
    "better-auth": "^1.6.14",
    "hono": "^4.12.18",
    "kysely": "0.28.17",
    "openai": "^6.37.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "wouter": "^3.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cloudflare/vite-plugin": "^1.39.0",
    "@cloudflare/workers-types": "^4.20260527.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.9.0",
    "portless": "^0.13.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.11",
    "wrangler": "^4.95.0"
  }
}
