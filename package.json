{
  "name": "typeling",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "portless typeling concurrently --kill-others --names server,web 'PORT=3001 bun --watch src/server/index.ts' 'vite'",
    "dev:direct": "concurrently --kill-others --names server,web 'PORT=3001 bun --watch src/server/index.ts' 'vite'",
    "server": "bun run src/server/index.ts",
    "web": "vite",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "gen:season": "bun run scripts/gen-season.ts",
    "e2e:happy-path": "bun run scripts/e2e/happy-path.ts",
    "e2e:wrong-key": "bun run scripts/e2e/wrong-key.ts",
    "e2e:idle": "bun run scripts/e2e/idle.ts"
  },
  "dependencies": {
    "hono": "^4.12.18",
    "openai": "^6.37.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "wouter": "^3.9.0",
    "zod": "^4.4.3"
  },

  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.9.0",
    "portless": "^0.13.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.11"
  }
}
